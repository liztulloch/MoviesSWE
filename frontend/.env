# Team default: talk to the real FastAPI backend.
# Vite reads env files only at startup - restart `npm run dev` after editing.
#
# To work without the backend running, create a frontend/.env.local (gitignored)
# containing VITE_USE_MOCK=true. It overrides this file for you only.
VITE_USE_MOCK=false
VITE_API_URL=http://localhost:8000

# Accounts, profile, cards and favorites use the fake backend in src/api/mockServer.ts
# until the real routes exist. Set to false to use the real backend for those too.
VITE_USE_MOCK_AUTH=false
